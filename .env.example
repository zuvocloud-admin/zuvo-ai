# ==============================================================================
# ZuvoCloud AI Solution - Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_DEBUG=true
PORT=8000

# Database Configuration (PostgreSQL Async Engine)
# Local SQLite for immediate zero-dependency testing: sqlite+aiosqlite:///./zuvo_local.db
# Production PostgreSQL: postgresql+asyncpg://zuvo_user:zuvo_password@postgres:5432/zuvo_db
DATABASE_URL=sqlite+aiosqlite:///./zuvo_local.db

# Redis Cache & Idempotency
REDIS_URL=redis://localhost:6379/0

# Meta WhatsApp Cloud API Credentials
META_VERIFY_TOKEN=zuvo_secret_verify_token_jaipur_2026
META_APP_SECRET=your_meta_app_secret_here
META_SYSTEM_USER_TOKEN=your_meta_system_user_access_token_here
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here
META_WABA_ID=your_meta_waba_id_here
META_API_VERSION=v20.0

# Security & Guardrails
REQUIRE_HMAC_VERIFICATION=false

# ngrok Tunnel Authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
